---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import { url } from '../../utils/url'

export async function getStaticPaths() {
    const posts = await getCollection('blog')
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    pageTitle="Blog"
    breadcrumbs={[
        { label: 'Titulní stránka', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: post.data.title },
    ]}
>
    <section class="blog-detail">
        <div class="container">
            <div
                class="article-details"
                itemscope
                itemtype="https://schema.org/Article"
            >
                <div class="article-header">
                    <h1 itemprop="headline">{post.data.title}</h1>
                </div>

                <div class="article-info">
                    <span
                        class="published"
                        title={`Zveřejněno: ${post.data.pubDate.toLocaleDateString('cs-CZ')}`}
                    >
                        <time
                            datetime={post.data.pubDate.toISOString()}
                            itemprop="datePublished"
                        >
                            {post.data.pubDate.toLocaleDateString('cs-CZ', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric',
                            })}
                        </time>
                    </span>
                </div>

                {post.data.heroImage && (
                    <div class="article-full-image">
                        <Image
                            src={post.data.heroImage}
                            alt={post.data.title}
                            widths={[512, 768, 1024]}
                            sizes="(max-width: 991px) 100vw, 900px"
                            itemprop="image"
                            loading="lazy"
                        />
                    </div>
                )}

                <div class="article-content" itemprop="articleBody">
                    <Content />
                </div>

                {post.data.tags && post.data.tags.length > 0 && (
                    <div class="article-tags">
                        <span>Štítky:</span>
                        <ul>
                            {post.data.tags.map((tag) => (
                                <li key={tag}>
                                    <a href={url(`blog?tag=${tag}`)}>{tag}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>

            <div class="article-navigation">
                <a href={url('blog')} class="btn btn-back">
                    &larr; Zpět na blog
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
