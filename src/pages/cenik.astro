---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/header/Header.astro'

const cenikData = {
  title: 'Ceník',
  pricing: [
    { description: 'Vstupní a navazující konzultace krátká (30 min.), např. u dg. dyslalie, logopedické poradenství', price: '600 Kč/30 min.' },
    { description: 'Vstupní a navazující Konzultace dlouhá (60 – 120 min)', price: '1200 Kč/60 min.' },
    { description: 'Zpráva z konzultace, max 2 str. A4', price: '500 Kč' },
    { description: 'Shrnující zpráva z logopedie na vyžádání, slouží jako podklad pro další odborná vyšetření', price: '1000 Kč' },
    { description: 'Storno poplatek za předem neomluvený termín logopedie z jiných než zdravotních důvodů', price: '500 Kč' }
  ],
  paymentInfo: 'Platbu přijímám v hotovosti, nebo na účet č. 4009 236 093/0800. Upřednostňuji platbu v hotovosti.',
  notes: [
    'Neposkytuji zdravotní péči dle zákona č. 372/2011 Sb., O zdravotních službách a podmínkách jejich poskytováním v platném znění.',
    'Nemám smlouvu s žádnou zdravotní pojišťovnou, proto veškeré platby jsou přímé a k přijetí do péče nepotřebuji žádanku od lékaře.'
  ]
}
---
<BaseLayout title={cenikData.title} showHeader={true} showFooter={true}>
    <Header title="Ceník" description="Ceník služeb" logoAlt="Logopedie v domácím prostředí" showTopBar={true} />

    <main class="container">
        <section id="sp-section-3">
            <div class="sp-page-title">
                <div class="container">
                    <h1 class="sp-page-title-heading">Ceník</h1>
                    <nav class="mod-breadcrumbs__wrapper" aria-label="Breadcrumbs">
                        <ol class="mod-breadcrumbs breadcrumb">
                            <li class="mod-breadcrumbs__item"><a href="/">Titulní stránka</a></li>
                            <li class="mod-breadcrumbs__item active"><span>Ceník</span></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </section>

        <section id="sp-main-body">
            <section class="pricing">
                <div class="container">
                    <h2 style="text-align: center; margin-bottom: 40px; font-size: 28px;">Ceník</h2>
                    <p style="text-align: center; max-width: 900px; margin: 0 auto 30px;">{cenikData.paymentInfo}</p>
                    <table class="pricing-table">
                        <thead>
                            <tr>
                                <th>Popis</th>
                                <th>Maximální cena</th>
                            </tr>
                        </thead>
                        <tbody>
                            {cenikData.pricing.map((item, j) => (
                                <tr key={j}>
                                    <td>{item.description}</td>
                                    <td>{item.price}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    <hr style="max-width: 900px; margin: 40px auto; border-color: #ddd;" />
                    <p style="max-width: 900px; margin: 0 auto;">Pozn.:</p>
                    <ul style="max-width: 900px; margin: 0 auto; padding-left: 20px;">
                        {cenikData.notes.map((note, j) => (
                            <li key={j}><span>{note}</span></li>
                        ))}
                    </ul>
                </div>
            </section>
        </section>
    </main>
</BaseLayout>