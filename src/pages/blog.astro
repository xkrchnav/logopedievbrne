---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
    title="Blog"
    description="Blog logopedie"
    pageTitle="Blog"
    breadcrumbs={[{ label: 'Titulní stránka', href: '/' }, { label: 'Blog' }]}
>
    <section class="blog">
        <div class="container">
            <div class="blog com-content-category-blog">
                <div class="article-list cols-3">
                    <div class="row">
                        {posts.map((post) => (
                            <div class="col-lg-4">
                                <div class="article" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
                                    {post.data.heroImage && (
                                        <div class="article-intro-image float-left">
                                            <a href={`/blog/${post.id}`}>
                                                <img
                                                    width="512"
                                                    height="381"
                                                    src={post.data.heroImage}
                                                    alt={post.data.title}
                                                    itemprop="thumbnailUrl"
                                                    decoding="async"
                                                    loading="lazy"
                                                />
                                            </a>
                                        </div>
                                    )}

                                    <div class="article-body">
                                        <div class="article-header">
                                            <h2>
                                                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                                            </h2>
                                        </div>

                                        <div class="article-info">
                                            <span class="published" title={`Zveřejněno: ${post.data.pubDate.toLocaleDateString('cs-CZ')}`}>
                                                <time datetime={post.data.pubDate.toISOString()}>
                                                    {post.data.pubDate.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}
                                                </time>
                                            </span>
                                        </div>

                                        <div class="article-introtext">
                                            <p>{post.data.description}</p>
                                        </div>

                                        <div class="readmore">
                                            <a href={`/blog/${post.id}`} itemprop="url" aria-label={`Číst dál … ${post.data.title}`}>
                                                Číst dál …
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
