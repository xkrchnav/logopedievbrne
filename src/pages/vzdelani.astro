---
<!DOCTYPE html>
<html lang="cs-cz">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>{vzdelaniData.title}</title>
</head>
<body>
    <Header title="Vzdělání" description="Vzdělání logopedy" logoAlt="Logopedie v domácím prostředí" showTopBar={true} />

    <main class="container">
        <section class="about">
            <div class="container">
                <h1>Vzdělání v oboru</h1>

                <h2>Vysokoškolské vzdělání</h2>
                <ul>
                    <li><span>Typ studia</span>{vzdelaniData.education[0].degree}</li>
                    <li><span>Obor</span>{vzdelaniData.education[0].field}</li>
                    <li><span>Zkouška</span>{vzdelaniData.education[0].exam}</li>
                    <li><span>Rok</span>{vzdelaniData.education[0].year}</li>
                </ul>
                <ul>
                    <li><span>Typ studia</span>{vzdelaniData.education[1].degree}</li>
                    <li><span>Obor</span>{vzdelaniData.education[1].field}</li>
                    <li><span>Zkouška</span>{vzdelaniData.education[1].exam}</li>
                    <li><span>Rok</span>{vzdelaniData.education[1].year}</li>
                </ul>

                <h2>Další absolvované odborné semináře a přednášky</h2>
                <ul>
                    {vzdelaniData.education[2].items.map((item, j) => (
                        <li key={j}>
                            <span>{item.year}</span>{item.description}
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-col">
                    <h4>Logopedie Brno</h4>
                    <p>Mgr. Jitka Rotscheinová</p>
                    <ul>
                        <li><a href="/">Úvod</a></li>
                        <li><a href="/o-mne">O mně</a></li>
                        <li><a href="/co-nabízím">Co nabízím</a></li>
                        <li><a href="/vzdelani">Vzdělání</a></li>
                        <li><a href="/ceník">Ceník</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/kontakt">Kontakt</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Kontakt:</h4>
                    <p>Mgr. Jitka Rotscheinová<br>Logoped, speciální pedagog</p>
                </div>
                <div class="footer-col">
                    <h4>Sledujte nás:</h4>
                    <div class="fb-page" data-href="https://www.facebook.com/profile.php?id=100087607171420&rdid=pN6WRxcjymjBFf78" data-tabs="" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
                        <blockquote cite="https://www.facebook.com/profile.php?id=100087607171420&rdid=pN6WRxcjymjBFf78" class="fb-xfbml-parse-ignore">
                            <a href="https://www.facebook.com/profile.php?id=100087607171420&rdid=pN6WRxcjymjBFf78">Logopedie v domácím prostředí</a>
                        </blockquote>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                © 2024 Mgr. Jitka Rotscheinová. Všechna práva vyhrazena.
            </div>
        </div>
    </footer>
</body>
</html>