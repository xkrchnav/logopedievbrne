---
<BaseLayout
    title="Vzdělání"
    description="Vzdělání logopedy"
    pageTitle="Vzdělání v oboru"
    breadcrumbs={[{ label: 'Titulní stránka', href: '/' }, { label: 'Vzdělání v oboru' }]}
>
    <section class="sppb-section page-text-section">
        <div class="container">
            <div class="edu-grid">
                <div class="edu-col-left">
                    <h2>Vysokoškolské vzdělání</h2>
                    <p>Masarykova univerzita Brno</p>
                    {studies.map((study) => (
                        <ul class="edu-info-list">
                            <li><span>Typ studia</span>{study.type}</li>
                            <li><span>Obor</span>{study.field}</li>
                            <li><span>Zkouška</span>{study.exam}</li>
                            <li><span>Rok</span>{study.year}</li>
                        </ul>
                    ))}
                </div>
                <div class="edu-col-right">
                    <h3>Další absolvované odborné semináře a přednášky</h3>
                    <ul class="icon-list">
                        {seminars.map((item) => (
                            <li>
                                <strong>{item.title}</strong>{item.suffix}
                                {item.lecturer && <><br />Přednášející: {item.lecturer}</>}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
