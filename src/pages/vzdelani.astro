      { year: '2014', description: 'Afázie II. - prim.PaedDr. M.Čecháčková' },
      { year: '2014', description: 'Úvodní kurz do metody R. Feuersteina - PaedDr. Eva Váňová' },
      { year: '2014', description: 'Poruchy řeči a sluchu z pozice foniatrie, klinické logopedie a psychiatrie - prof. MUDr. Ivo Paclt, CSc.' },
      { year: '2015', description: 'Orofaciálna a bazálna stimulácia u detí s psychomotorickým oneskorením v ranom veku - PaedDr. A. Fabianová, PhDr. Z. Jandová' },
