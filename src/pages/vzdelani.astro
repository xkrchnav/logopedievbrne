      { year: '2019', description: 'Prvky senzorické integrační terapie v logopedické praxi - Mgr. Barbora Červenková' },
      { year: '2019', description: 'Pokročilé dechové a fonační techniky doplněné stimulací akupresurních drah čakrového systému - Mgr. Petra Tabačíková' },
      { year: '2019', description: 'Mutismus - Pa­edDr. Dana Kutálková' },
      { year: '2019', description: 'Základní postupy v aplikované behaviorální analýze - Mgr. Zuzana Maštenová, BCBA' },
      { year: '2019', description: 'Úvod do senzorické intergrace pro pomáhající profese v sociálních službách - Paedr. Jana Hrčová, Ph.D' },
      { year: '2020', description: 'Intuitivní rodičovství jeho poruchy a možnosti prevence a intervence - Mgr. Kateřina Šilhánová' },
      { year: '2020', description: 'Sexuálita lidí s poruchou autistického spektra - organizace Freya' },
      { year: '2022', description: 'Specifika smyslového vnímání u osob s poruchami autistického spektra a strategie jeho rozvoje - Paedr. Jana Hrčová, Ph.D' },
      { year: '2022', description: 'Zahájení studia tradiční čínské medicíny - MUDr. Alexandra Vosátková' },
