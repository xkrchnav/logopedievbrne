    { degree: 'Magisterské', field: 'Speciální pedagogika', exam: 'speciální pedagogika, logopedie, surdopedie, specifické poruchy učení, pedagogika/psychologie', year: '2011' },
    { title: 'Další absolvované odborné semináře a přednášky', items: [
      { year: '2007', description: 'Trénink fonematického uvědomování podle Elkonina - Doc. PhDr. Marína Mikulajová, CSc.' },
