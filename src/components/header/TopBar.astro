---
// Replicates the Joomla #sp-top section (top bar with angled module)
// Original: <section id="sp-top"><div class="row"><div id="sp-top1" class="col-lg-12">...
interface Props {
  email?: string
  hours?: string
  phone?: string
}

const {
  email = 'info@logopedievbrne.cz',
  hours = 'Po, Út: 8:00 - 16:00',
  phone = '737 365 338',
} = Astro.props;
---
<section id="sp-top">
  <div class="container">
    <div class="row">
      <div id="sp-top1" class="col-lg-12">
        <div class="sp-column">
          <div class="sp-module">
            <div class="sp-module-content">
              <div class="main-header__top-left">
                <ul class="main-header__top-address">
                  <li>
                    <div class="icon">
                      <span class="icon-email" aria-hidden="true"></span>
                    </div>
                    <div class="text">
                      <p><a href={`mailto:${email}`}>{email}</a></p>
                    </div>
                  </li>
                  <li>
                    <div class="icon">
                      <span class="icon-wall-clock" aria-hidden="true"></span>
                    </div>
                    <div class="text">
                      <p>{hours}</p>
                    </div>
                  </li>
                  <li>
                    <div class="icon">
                      <span class="icon-user" aria-hidden="true"></span>
                    </div>
                    <div class="text">
                      <p>{phone}</p>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
