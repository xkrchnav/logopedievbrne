---
import { stripBase, url } from '../../utils/url'

// Replicates the Joomla offcanvas menu markup.
const items = [
    { label: 'Úvod', href: '/', id: 101 },
    { label: 'O mně', href: '/o-mne', id: 121 },
    { label: 'Co nabízím', href: '/co-nabizim', id: 196 },
    { label: 'Vzdělání', href: '/vzdelani', id: 197 },
    { label: 'Ceník', href: '/cenik', id: 198 },
    { label: 'Blog', href: '/blog', id: 145 },
    { label: 'Kontakt', href: '/kontakt', id: 150 },
]

const pathname = stripBase(Astro.url.pathname)

const isActive = (href: string) => {
    if (href === '/') return pathname === '/'
    return pathname === href || pathname.startsWith(href + '/')
}
---

<div class="offcanvas-menu">
    <div class="d-flex align-items-center p-3 pt-4">
        <a href="#" class="close-offcanvas" aria-label="Zavřít menu">
            <div class="burger-icon" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </a>
    </div>
    <div class="offcanvas-inner">
        <div class="d-flex header-modules mb-3"></div>
        <div class="sp-module">
            <div class="sp-module-content">
                <ul class="mod-menu mod-list menu nav-pills">
                    {items.map((item) => (
                        <li
                            class={`item-${item.id}${isActive(item.href) ? ' default current active' : ''}`}
                        >
                            <a
                                href={url(item.href)}
                                aria-current={
                                    isActive(item.href) ? 'page' : undefined
                                }
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</div>
