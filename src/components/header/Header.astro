---
import './Header.css'

export interface HeaderProps {
  title: string
  description: string
  logoAlt: string
  showTopBar?: boolean
}

const { title, description, logoAlt, showTopBar = true } = Astro.props;
---
{showTopBar && (
  <section id="sp-top">
    <div class="container">
      <ul class="main-header__top-address">
        <li>
          <div class="icon">
            <span class="icon-email">✉</span>
          </div>
          <div class="text">
            <p><a href="mailto:info@logopedievbrne.cz">info@logopedievbrne.cz</a></p>
          </div>
        </li>
        <li>
          <div class="icon">
            <span class="icon-wall-clock">🕐</span>
          </div>
          <div class="text">
            <p>Po - Pá: 8:00 - 17:30</p>
          </div>
        </li>
        <li>
          <div class="icon">
            <span class="icon-user">📞</span>
          </div>
          <div class="text">
            <p>737 365 338</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
)}

<header id="sp-header">
  <div class="container container-inner">
    <a id="offcanvas-toggler" aria-label="Navigace" class="offcanvas-toggler-left" href="#" aria-hidden="true" title="Navigace">
      <div class="burger-icon">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </a>
    <div class="logo">
      <a href="/">
        <img class="logo-image" 
             srcset="/images/logo.png 1x, /images/retina.png 2x" 
             src="/images/logo.png" 
             height="44px" 
             alt={logoAlt} 
             loading="lazy" />
      </a>
    </div>
    <nav class="sp-megamenu-wrapper" role="navigation" aria-label="Hlavní navigace">
      <ul class="sp-megamenu-parent menu-animation-fade-down">
        <li class="sp-menu-item"><a href="/">Úvod</a></li>
        <li class="sp-menu-item"><a href="/o-mne">O mně</a></li>
        <li class="sp-menu-item"><a href="/co-nabizim">Co nabízím</a></li>
        <li class="sp-menu-item"><a href="/vzdelani">Vzdělání</a></li>
        <li class="sp-menu-item"><a href="/cenik">Ceník</a></li>
        <li class="sp-menu-item"><a href="/blog">Blog</a></li>
        <li class="sp-menu-item"><a href="/kontakt">Kontakt</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggler = document.getElementById('offcanvas-toggler');
  const menu = document.querySelector('.sp-megamenu-wrapper');
  const closeBtn = document.querySelector('.close-offcanvas');
  
  if (toggler && menu) {
    toggler.addEventListener('click', (e) => {
      e.preventDefault();
      menu.classList.toggle('open');
    });
  }
  
  if (closeBtn && menu) {
    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      menu.classList.remove('open');
    });
  }
  
  document.addEventListener('click', (e) => {
    if (menu && menu.classList.contains('open')) {
      if (!menu.contains(e.target) && !toggler?.contains(e.target)) {
        menu.classList.remove('open');
      }
    }
  });
});
</script>