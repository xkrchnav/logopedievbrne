---
import './Header.css'

export interface HeaderProps {
  title: string
  description: string
  logoAlt: string
  showTopBar?: boolean
}
---
<div class="header">
    <div class="top-bar">
        <div class="container">
            <div class="address">
                <p><a href="mailto:info@logopedievbrne.cz">info@logopedievbrne.cz</a></p>
                <p>737 365 338</p>
                <p>Po - Pá: 8:00 - 17:30</p>
            </div>
        </div>
    </div>

    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto logo">
                    <a href="/">
                        <img src="/images/logo.png" alt="{logoAlt}" loading="lazy" />
                    </a>
                </div>
                <div class="col-12 col-md-9 main-nav text-center text-md-left">
                    <nav>
                        <ul class="nav">
                            <li><a href="/">Úvod</a></li>
                            <li><a href="/o-mne">O mně</a></li>
                            <li><a href="/co-nabízím">Co nabízím</a></li>
                            <li><a href="/vzdelani">Vzdělání</a></li>
                            <li><a href="/ceník">Ceník</a></li>
                            <li><a href="/blog">Blog</a></li>
                            <li><a href="/kontakt">Kontakt</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </header>
</div>